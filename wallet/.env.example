# The mint this wallet points at by default. Set it in your host's env (e.g. Vercel → Project →
# Settings → Environment Variables) to bake in the live mint at build time. The mint-URL field in
# the UI stays editable, so users can still point at any other mint.
#
# Vite only exposes vars prefixed with VITE_, and it's a BUILD-TIME value (baked into the bundle),
# so redeploy after changing it.
VITE_MINT_URL=https://mint.fibernuts.xyz

# Operator-declared network label. Cashu mint metadata does not currently prove the Fiber network,
# so the wallet shows this as local configuration rather than inferring it from the unit ticker.
VITE_NETWORK_LABEL=CKB Testnet / Fiber
