# fibernuts services — copy this to `.env` and fill in the SIX values below.
# Everything else is detected or generated for you. Keep `.env` private (it's gitignored).

# ── 1. Your domain ────────────────────────────────────────────────────────────
# A domain (or subdomain) you own, with a DNS A record pointing at THIS server's IP.
# It becomes your mint's address — wallets connect to https://<this>. Caddy gets the
# TLS cert for it automatically. You buy/own this; there's nothing to look up.
# The FiberNuts reference deployment uses mint.fibernuts.xyz.
MINT_DOMAIN=mint.example.com

# ── 2. Payment relay domain ──────────────────────────────────────────────────
# A second DNS A record pointing at this same server. Capability-bearing payment delivery goes
# through this origin; it must not share the mint API hostname.
RELAY_DOMAIN=pay.example.com

# ── 3. Testnet claim service domain ──────────────────────────────────────────
# A third DNS A record pointing at the same server. This API pays only validated, fixed-amount
# mint quotes from its separate Fiber node.
FAUCET_DOMAIN=claim.example.com

# ── 4. Deployed market origin ────────────────────────────────────────────────
# Exact browser origin allowed to call the relay. Do not use `*`. Separate multiple exact origins
# with commas only when both are trusted deployments.
MARKET_ALLOWED_ORIGINS=https://market.example.com

# ── 5. The mint's mnemonic (its master key) ───────────────────────────────────
# A 12-word BIP-39 phrase. It seeds every signing key, so BACK IT UP offline and never
# change it. Generate one with:
#   docker run --rm python:3.12-slim sh -c "pip -q install mnemonic && python -c 'from mnemonic import Mnemonic;print(Mnemonic(\"english\").generate(128))'"
MINT_MNEMONIC="paste your twelve word phrase here"

# ── 6. Claim identifier secret ───────────────────────────────────────────────
# Used only to hash browser and network rate-limit identifiers. It is not a wallet or mint key.
# Generate it with: openssl rand -hex 32
FAUCET_IDENTIFIER_SECRET=paste-a-random-64-character-hex-string-here

# ── That's it. Below are OPTIONAL overrides you normally leave commented out. ──
# The server's public IP is auto-detected; only set this if detection is blocked
# (e.g. behind a proxy that hides the real IP):
# PUBLIC_IP=203.0.113.10
#
# The node's key-encryption password is auto-generated and persisted; only set this
# if you want to control it yourself:
# FIBER_SECRET_KEY_PASSWORD=some-strong-random-string
#
# A friendly name announced to the Fiber network:
# MINT_NODE_NAME=fibernuts-mint
# FAUCET_NODE_NAME=fibernuts-faucet
#
# Relay retention and abuse limits:
# RELAY_MAX_TTL_SECONDS=600
# RELAY_RETENTION_SECONDS=3600
# RELAY_MAX_REQUESTS_PER_MINUTE=120
#
# Community testnet claim amount and abuse limits. Claims start paused so the separately funded
# channel can be verified first. Change this to true only after that channel is ready.
FAUCET_ENABLED=false
# Amount is in ecash cents (1000 = 10.00 RUSD):
# FAUCET_AMOUNT=1000
# FAUCET_CLIENT_COOLDOWN_SECONDS=86400
# FAUCET_NETWORK_DAILY_CLAIM_LIMIT=3
# FAUCET_DAILY_CLAIM_LIMIT=25
# FAUCET_MAX_REQUESTS_PER_MINUTE=120
