# Automatic HTTPS in front of the mint and relay APIs. Both hostnames need A records pointing at
# this server before Caddy can obtain their certificates.

{$MINT_DOMAIN} {
	# mintd listens on 0.0.0.0:8085 inside fnn's network namespace; the fnn container is
	# reachable by name on the shared bridge network.
	reverse_proxy fnn:8085
	encode zstd gzip
}

{$RELAY_DOMAIN} {
	# Access logging is intentionally disabled because delivery paths contain bearer capabilities.
	reverse_proxy relay:8090
	encode zstd gzip
}
